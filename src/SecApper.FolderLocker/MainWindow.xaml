                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- PRIVACY & LOCAL STORAGE -->
                        <Border Style="{StaticResource SecurityCard}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="PRIVACY &amp; LOCAL STORAGE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" Margin="0,0,0,16" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Local Storage Only" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="All keys, folder descriptors, and logs remain strictly on this PC in SQLite." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource SuccessBg}" BorderBrush="{StaticResource SuccessBorder}" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock Text="ENFORCED" Foreground="#027A48" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Telemetry &amp; Cloud Tracking" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="SecApper transmits zero analytics or folder data." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock Text="DISABLED" Foreground="#64748B" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ABOUT SECAPPER WITH OFFICIAL LOGO -->
                        <Border Style="{StaticResource SecurityCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Official SecApper Logo Frame -->
                                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="14,10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" VerticalAlignment="Top" Margin="0,0,24,0" Effect="{StaticResource LogoShadow}">
                                    <Image Source="pack://application:,,,/Resources/logo.png" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="SecApper" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" />
                                    <TextBlock Text="SECURE YOUR WORLD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandRed}" Margin="0,2,0,12" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" LineHeight="20">
                                        <Run Text="SecApper is a commercial-grade Windows desktop application providing native NTFS filesystem access restriction, offline cryptographic key derivation, local SQLite storage, and active ransomware heuristic monitoring." />
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0">
                                        <Run Text="Engine Version: " /><Run Text="{Binding CurrentAppVersion, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                        <Run Text="  |  Platform: Windows x64 (NTFS ACL Engine)" />
                                    </TextBlock>
                                    <TextBlock Text="Copyright © SecApper. All rights reserved." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- SUBTLE BOTTOM STATUS BAR -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="32,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Offline-First Engine" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0" />
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Database Connected" FontSize="11" FontWeight="Medium" Foreground="{StaticResource SuccessGreen}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
