<Window x:Class="SecApper.FolderLocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SecApper.FolderLocker.ViewModels"
        Title="SecApper — Secure Your World"
        Height="820" Width="1240"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FB"
        Foreground="#101828"
        FontFamily="Segoe UI, Segoe UI Variable, Inter, sans-serif"
        Icon="Resources/app.ico"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ======================================================== -->
        <!-- SECAPPER OFFICIAL CYBERSECURITY COLOR SYSTEM            -->
        <!-- ======================================================== -->
        <!-- Navy Palette (Primary Brand Identity) -->
        <SolidColorBrush x:Key="BrandNavy" Color="#122D55" />
        <SolidColorBrush x:Key="DarkNavy" Color="#091D38" />
        <SolidColorBrush x:Key="DeepestNavy" Color="#06152A" />
        <SolidColorBrush x:Key="SidebarBg" Color="#06152A" />
        <SolidColorBrush x:Key="SidebarSurface" Color="#0B1B32" />
        <SolidColorBrush x:Key="SidebarHover" Color="#0E223D" />
        <SolidColorBrush x:Key="SidebarActive" Color="#122D55" />
        <SolidColorBrush x:Key="SidebarBorder" Color="#0F2442" />
        <SolidColorBrush x:Key="SidebarTextMuted" Color="#8EA2C6" />

        <!-- Red Palette (Security Accent) -->
        <SolidColorBrush x:Key="BrandRed" Color="#C5202B" />
        <SolidColorBrush x:Key="BrandRedHover" Color="#A81720" />
        <SolidColorBrush x:Key="LightRed" Color="#FCEBED" />
        <SolidColorBrush x:Key="DangerRed" Color="#D92D20" />
        <SolidColorBrush x:Key="DangerBg" Color="#FEF3F2" />
        <SolidColorBrush x:Key="DangerBorder" Color="#FECDCA" />

        <!-- Neutral & Content Canvas -->
        <SolidColorBrush x:Key="CanvasBg" Color="#F6F8FB" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#E4E7EC" />
        <SolidColorBrush x:Key="BorderLight" Color="#F2F4F7" />
        <SolidColorBrush x:Key="TextPrimary" Color="#101828" />
        <SolidColorBrush x:Key="TextSecondary" Color="#667085" />
        <SolidColorBrush x:Key="TextMuted" Color="#98A2B3" />

        <!-- Status Accents -->
        <SolidColorBrush x:Key="SuccessGreen" Color="#12B76A" />
        <SolidColorBrush x:Key="SuccessBg" Color="#ECFDF3" />
        <SolidColorBrush x:Key="SuccessBorder" Color="#D1FADF" />
        <SolidColorBrush x:Key="WarningAmber" Color="#F79009" />
        <SolidColorBrush x:Key="WarningBg" Color="#FFFAEB" />
        <SolidColorBrush x:Key="WarningBorder" Color="#FEDF89" />

        <!-- Subtle Shadows (Soft, Commercial Desktop Application) -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" Direction="270" ShadowDepth="2" Opacity="0.05" Color="#0F172A" />
        <DropShadowEffect x:Key="HeroShadow" BlurRadius="20" Direction="270" ShadowDepth="3" Opacity="0.06" Color="#0F172A" />
        <DropShadowEffect x:Key="LogoShadow" BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.08" Color="#000000" />
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.18" Color="#C5202B" />
        <DropShadowEffect x:Key="NavyBtnShadow" BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.16" Color="#122D55" />

        <!-- Lucide Vector Geometries -->
        <StreamGeometry x:Key="GeoDashboard">M4 4h7v7H4z M13 4h7v4h-7z M13 11h7v9h-7z M4 14h7v6H4z</StreamGeometry>
        <StreamGeometry x:Key="GeoLock">M7 11V7a5 5 0 0 1 10 0v4 M5 11h14v10H5z M12 15v2</StreamGeometry>
        <StreamGeometry x:Key="GeoUnlock">M7 11V7a5 5 0 0 1 9.9-1 M5 11h14v10H5z M12 15v2</StreamGeometry>
        <StreamGeometry x:Key="GeoFolderLock">M4 4h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M10 13a2 2 0 0 1 4 0v1h1v4H9v-4h1v-1z</StreamGeometry>
        <StreamGeometry x:Key="GeoShield">M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z</StreamGeometry>
        <StreamGeometry x:Key="GeoShieldAlert">M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M12 8v4 M12 16h.01</StreamGeometry>
        <StreamGeometry x:Key="GeoShieldCheck">M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M9 12l2 2 4-4</StreamGeometry>
        <StreamGeometry x:Key="GeoActivity">M22 12h-4l-3 9L9 3l-3 9H2</StreamGeometry>
        <StreamGeometry x:Key="GeoRotateCcw">M1 4v6h6 M3.51 15a9 9 0 1 0 2.13-9.36L1 10</StreamGeometry>
        <StreamGeometry x:Key="GeoDownloadCloud">M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242 M12 12v9 M8 17l4 4 4-4</StreamGeometry>
        <StreamGeometry x:Key="GeoSettings">M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z</StreamGeometry>
        <StreamGeometry x:Key="GeoRefresh">M21 2v6h-6 M3 12a9 9 0 0 1 15-6.7L21 8 M3 22v-6h6 M21 12a9 9 0 0 1-15 6.7L3 16</StreamGeometry>
        <StreamGeometry x:Key="GeoPlus">M12 5v14 M5 12h14</StreamGeometry>
        <StreamGeometry x:Key="GeoFolder">M4 4h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z</StreamGeometry>
        <StreamGeometry x:Key="GeoSearch">M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35</StreamGeometry>
        <StreamGeometry x:Key="GeoCheck">M20 6L9 17l-5-5</StreamGeometry>
        <StreamGeometry x:Key="GeoAlertTriangle">M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01</StreamGeometry>
        <StreamGeometry x:Key="GeoInfo">M12 16v-4 M12 8h.01 M22 12A10 10 0 1 1 12 2a10 10 0 0 1 10 10z</StreamGeometry>
        <StreamGeometry x:Key="GeoExternalLink">M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6 M15 3h6v6 M10 14L21 3</StreamGeometry>
        <StreamGeometry x:Key="GeoTrash">M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2</StreamGeometry>
        <StreamGeometry x:Key="GeoChevronRight">M9 18l6-6-6-6</StreamGeometry>

        <!-- Vector Icon Style -->
        <Style TargetType="Path">
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <!-- Primary Red Security Action Button -->
        <Style x:Key="BrandRedBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandRed}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandRedHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Navy Button -->
        <Style x:Key="PrimaryNavyBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandNavy}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkNavy}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Outline Button -->
        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Outline Button -->
        <Style x:Key="DangerOutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerBg}" />
            <Setter Property="Foreground" Value="{StaticResource BrandRed}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEE4E2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean Security Card (Sharp 10px Radius, Subtle Border) -->
        <Style x:Key="SecurityCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>

        <!-- Hero Security Card (12px Radius) -->
        <Style x:Key="HeroSecurityCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="32,28" />
            <Setter Property="Effect" Value="{StaticResource HeroShadow}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 1. Fixed Left Sidebar (250px) -->
            <ColumnDefinition Width="250" />
            <!-- 2. Main Application Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- 1. PREMIUM SIDEBAR (DEEPEST NAVY #06152A)               -->
        <!-- ======================================================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Official SecApper Logo Frame -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Groups -->
                    <RowDefinition Height="*" />
                    <!-- Security Footer with Dynamic Version -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TOP: Official SecApper Logo in Clean Sharp Container -->
                <Border Grid.Row="0" Margin="16,20,16,16" Background="#FFFFFF" CornerRadius="8" Padding="14,10" Effect="{StaticResource LogoShadow}">
                    <Image Source="pack://application:,,,/Resources/logo.png"
                           Height="64"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           ToolTip="SecApper — Secure Your World" />
                </Border>

                <!-- NAVIGATION GROUPS (SECURITY & SYSTEM) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,4">
                    <StackPanel Margin="10,0">
                        <!-- SECTION 1: SECURITY -->
                        <TextBlock Text="SECURITY" Foreground="#5A7196" FontSize="11" FontWeight="Bold" Margin="14,10,12,6" />

                        <!-- 1. Dashboard -->
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="Dashboard" Cursor="Hand" Margin="0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Height="44" Padding="12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Elegant Left Red Accent Indicator -->
                                            <Border x:Name="AccentBar" Grid.Column="0" Background="{StaticResource BrandRed}" CornerRadius="2" Height="22" Width="3.5" Visibility="Collapsed" HorizontalAlignment="Left" />
                                            <Path Grid.Column="1" Data="{StaticResource GeoDashboard}" Stroke="{StaticResource SidebarTextMuted}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="IconPath" />
                                            <TextBlock Grid.Column="2" Text="Dashboard" Foreground="{StaticResource SidebarTextMuted}" FontSize="13.5" FontWeight="Normal" VerticalAlignment="Center" Margin="10,0,0,0" x:Name="LabelText" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="Dashboard">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarActive}" />
                                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 2. Folder Locker -->
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="FolderLocker" Cursor="Hand" Margin="0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Height="44" Padding="12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBar" Grid.Column="0" Background="{StaticResource BrandRed}" CornerRadius="2" Height="22" Width="3.5" Visibility="Collapsed" HorizontalAlignment="Left" />
                                            <Path Grid.Column="1" Data="{StaticResource GeoLock}" Stroke="{StaticResource SidebarTextMuted}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="IconPath" />
                                            <TextBlock Grid.Column="2" Text="Folder Locker" Foreground="{StaticResource SidebarTextMuted}" FontSize="13.5" FontWeight="Normal" VerticalAlignment="Center" Margin="10,0,0,0" x:Name="LabelText" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="FolderLocker">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarActive}" />
                                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 3. Protected Folders -->
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="ProtectedFolders" Cursor="Hand" Margin="0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Height="44" Padding="12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBar" Grid.Column="0" Background="{StaticResource BrandRed}" CornerRadius="2" Height="22" Width="3.5" Visibility="Collapsed" HorizontalAlignment="Left" />
                                            <Path Grid.Column="1" Data="{StaticResource GeoFolderLock}" Stroke="{StaticResource SidebarTextMuted}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="IconPath" />
                                            <TextBlock Grid.Column="2" Text="Protected Folders" Foreground="{StaticResource SidebarTextMuted}" FontSize="13.5" FontWeight="Normal" VerticalAlignment="Center" Margin="10,0,0,0" x:Name="LabelText" />
                                            <!-- Real Count Badge -->
                                            <Border Grid.Column="3" Background="#0C2346" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalFoldersCount, Mode=OneWay}" Foreground="#93C5FD" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="ProtectedFolders">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarActive}" />
                                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 4. Ransomware Protection -->
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="RansomwareProtection" Cursor="Hand" Margin="0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Height="44" Padding="12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBar" Grid.Column="0" Background="{StaticResource BrandRed}" CornerRadius="2" Height="22" Width="3.5" Visibility="Collapsed" HorizontalAlignment="Left" />
                                            <Path Grid.Column="1" Data="{StaticResource GeoShieldAlert}" Stroke="{StaticResource SidebarTextMuted}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="IconPath" />
                                            <TextBlock Grid.Column="2" Text="Ransomware Protection" Foreground="{StaticResource SidebarTextMuted}" FontSize="13.5" FontWeight="Normal" VerticalAlignment="Center" Margin="10,0,0,0" x:Name="LabelText" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="RansomwareProtection">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarActive}" />
                                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 5. Security Events -->
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="SecurityEvents" Cursor="Hand" Margin="0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Height="44" Padding="12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBar" Grid.Column="0" Background="{StaticResource BrandRed}" CornerRadius="2" Height="22" Width="3.5" Visibility="Collapsed" HorizontalAlignment="Left" />
                                            <Path Grid.Column="1" Data="{StaticResource GeoActivity}" Stroke="{StaticResource SidebarTextMuted}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="IconPath" />
                                            <TextBlock Grid.Column="2" Text="Security Events" Foreground="{StaticResource SidebarTextMuted}" FontSize="13.5" FontWeight="Normal" VerticalAlignment="Center" Margin="10,0,0,0" x:Name="LabelText" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="SecurityEvents">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarActive}" />
                                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 6. Recovery -->
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="Recovery" Cursor="Hand" Margin="0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Height="44" Padding="12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBar" Grid.Column="0" Background="{StaticResource BrandRed}" CornerRadius="2" Height="22" Width="3.5" Visibility="Collapsed" HorizontalAlignment="Left" />
                                            <Path Grid.Column="1" Data="{StaticResource GeoRotateCcw}" Stroke="{StaticResource SidebarTextMuted}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="IconPath" />
                                            <TextBlock Grid.Column="2" Text="Recovery Center" Foreground="{StaticResource SidebarTextMuted}" FontSize="13.5" FontWeight="Normal" VerticalAlignment="Center" Margin="10,0,0,0" x:Name="LabelText" />
                                            <!-- Alert indicator dot if issues detected -->
                                            <Ellipse Grid.Column="3" Width="8" Height="8" Fill="{StaticResource BrandRed}" Visibility="{Binding HasRecoveryIssues, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="Recovery">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarActive}" />
                                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- SECTION 2: SYSTEM -->
                        <TextBlock Text="SYSTEM" Foreground="#5A7196" FontSize="11" FontWeight="Bold" Margin="14,18,12,6" />

                        <!-- 7. Updates -->
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="Updates" Cursor="Hand" Margin="0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Height="44" Padding="12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBar" Grid.Column="0" Background="{StaticResource BrandRed}" CornerRadius="2" Height="22" Width="3.5" Visibility="Collapsed" HorizontalAlignment="Left" />
                                            <Path Grid.Column="1" Data="{StaticResource GeoDownloadCloud}" Stroke="{StaticResource SidebarTextMuted}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="IconPath" />
                                            <TextBlock Grid.Column="2" Text="Software Updates" Foreground="{StaticResource SidebarTextMuted}" FontSize="13.5" FontWeight="Normal" VerticalAlignment="Center" Margin="10,0,0,0" x:Name="LabelText" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="Updates">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarActive}" />
                                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 8. Settings -->
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="Settings" Cursor="Hand" Margin="0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Height="44" Padding="12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBar" Grid.Column="0" Background="{StaticResource BrandRed}" CornerRadius="2" Height="22" Width="3.5" Visibility="Collapsed" HorizontalAlignment="Left" />
                                            <Path Grid.Column="1" Data="{StaticResource GeoSettings}" Stroke="{StaticResource SidebarTextMuted}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="IconPath" />
                                            <TextBlock Grid.Column="2" Text="Settings" Foreground="{StaticResource SidebarTextMuted}" FontSize="13.5" FontWeight="Normal" VerticalAlignment="Center" Margin="10,0,0,0" x:Name="LabelText" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="Settings">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarActive}" />
                                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- BOTTOM OF SIDEBAR: SecApper Security Identity & Engine Version -->
                <Border Grid.Row="2" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,1,0,0" Padding="18,16" Background="#040F1D">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Official Shield Icon Badge -->
                        <Border Grid.Column="0" Background="#0C203D" CornerRadius="6" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoShield}" Stroke="{StaticResource BrandRed}" StrokeThickness="1.8" Fill="Transparent" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SecApper Security" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text=" · " Foreground="#5A7196" FontSize="12" />
                                <TextBlock Foreground="#8EA2C6" FontSize="11.5">
                                    <Run Text="v" /><Run Text="{Binding CurrentAppVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Protected locally" Foreground="{StaticResource SuccessGreen}" FontSize="11" FontWeight="Medium" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. MAIN APPLICATION CONTENT                              -->
        <!-- ======================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Clean Native Desktop Header (64px) -->
                <RowDefinition Height="Auto" />
                <!-- Active Threat Alert Banner (Emergency) -->
                <RowDefinition Height="Auto" />
                <!-- Dynamic Page View Surface -->
                <RowDefinition Height="*" />
                <!-- Subtle Desktop Status Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TOP HEADER -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="32,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Title & Subtitle -->
                        <ColumnDefinition Width="*" />
                        <!-- Status Badge & Controls -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding PageSubtitle, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Header Right: System Security Status & Action Icons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Protection State Badge -->
                        <Border Background="{Binding SystemSecurityStatusBadgeBackground, Mode=OneWay}"
                                BorderBrush="{Binding SystemSecurityStatusBrush, Mode=OneWay}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,5"
                                Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding SystemSecurityStatusBrush, Mode=OneWay}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SystemSecurityStatusText, Mode=OneWay}"
                                           Foreground="{Binding SystemSecurityStatusBrush, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Refresh Status -->
                        <Button Style="{StaticResource OutlineBtn}" Command="{Binding RefreshCommand}" ToolTip="Refresh security status and verify integrity" Width="36" Height="36" Padding="0" Margin="0,0,8,0">
                            <Path Data="{StaticResource GeoRefresh}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" Width="15" Height="15" />
                        </Button>

                        <!-- Settings Shortcut -->
                        <Button Style="{StaticResource OutlineBtn}" Command="{Binding SelectTabCommand}" CommandParameter="Settings" ToolTip="SecApper Settings" Width="36" Height="36" Padding="0">
                            <Path Data="{StaticResource GeoSettings}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- EMERGENCY ACTIVE THREAT BANNER -->
            <Border Grid.Row="1" Background="{StaticResource DangerBg}" BorderBrush="{StaticResource DangerBorder}" BorderThickness="0,0,0,1" Padding="28,14" Visibility="{Binding HasActiveAlert, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Data="{StaticResource GeoAlertTriangle}" Fill="{StaticResource BrandRed}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CRITICAL SUSPICIOUS ACTIVITY DETECTED" Foreground="#991B1B" FontWeight="Bold" FontSize="13" />
                        <TextBlock Foreground="#B91C1C" FontSize="12.5" Margin="0,2,0,0">
                            <Run Text="Threat Score: " /><Run Text="{Binding ActiveAlert.ThreatScore, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text=" | Process: " /><Run Text="{Binding ActiveAlert.ProcessName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" | Target: " /><Run Text="{Binding ActiveAlert.FolderPath, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🚨 Panic Lock Folders" Style="{StaticResource BrandRedBtn}" Command="{Binding PanicLockCommand}" Margin="0,0,8,0" Height="34" Padding="14,0" />
                        <Button Content="Dismiss" Style="{StaticResource OutlineBtn}" Command="{Binding DismissAlertCommand}" Height="34" Padding="12,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DYNAMIC SCROLLABLE PAGE CANVAS -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="32,28,32,32">

                    <!-- ==================================================== -->
                    <!-- PAGE 1: DASHBOARD (THE HERO SECURITY CENTER)         -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="ViewDashboard">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Dashboard">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- 1. LARGE SECURITY STATUS HERO SECTION -->
                        <Border Style="{StaticResource HeroSecurityCard}" Margin="0,0,0,28">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="720">
                                <!-- Official SecApper Shield Visual Anchor -->
                                <Border Background="#FFFFFF" CornerRadius="12" Width="68" Height="68" Margin="0,0,0,16" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" HorizontalAlignment="Center" Effect="{StaticResource LogoShadow}">
                                    <Image Source="pack://application:,,,/Resources/shield.png" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Prominent System Protected Heading -->
                                <TextBlock Text="YOUR SYSTEM IS PROTECTED" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="SecApper is actively protecting your protected folders with native Windows security permissions." FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,14" TextAlignment="Center" />

                                <!-- Protection Active Status Badge -->
                                <Border Background="{Binding SystemSecurityStatusBadgeBackground, Mode=OneWay}"
                                        BorderBrush="{Binding SystemSecurityStatusBrush, Mode=OneWay}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14,5"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{Binding SystemSecurityStatusBrush, Mode=OneWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SystemSecurityStatusText, Mode=OneWay}"
                                                   Foreground="{Binding SystemSecurityStatusBrush, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <!-- Subtle Separator -->
                                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,24,0,20" />

                                <!-- Clean Metrics Strip (Real Backend Values) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Metric 1: Protected Folders -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="PROTECTED FOLDERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding TotalFoldersCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        <TextBlock Text="folders secured" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{StaticResource CardBorder}" Width="1" Margin="0,4" />

                                    <!-- Metric 2: Ransomware Protection -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="RANSOMWARE PROTECTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                        <TextBlock Text="ACTIVE" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        <TextBlock Text="monitoring NTFS" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="3" Background="{StaticResource CardBorder}" Width="1" Margin="0,4" />

                                    <!-- Metric 3: Security Events -->
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                        <TextBlock Text="SECURITY EVENTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SecurityEvents.Count, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        <TextBlock Text="logged offline" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="5" Background="{StaticResource CardBorder}" Width="1" Margin="0,4" />

                                    <!-- Metric 4: Threat Level -->
                                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                        <TextBlock Text="THREAT LEVEL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ThreatLevelText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{Binding ThreatLevelBadgeColor, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        <TextBlock Text="real-time score" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. QUICK ACTIONS (Focused Row of 4 Essential Actions) -->
                        <StackPanel Margin="0,0,0,28">
                            <TextBlock Text="QUICK ACTIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Action 1: Protect Folder (Primary Highlight) -->
                                <Button Grid.Column="0" Style="{StaticResource BrandRedBtn}" Command="{Binding AddFolderCommand}" Height="44" Effect="{StaticResource ButtonShadow}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoPlus}" Stroke="#FFFFFF" StrokeThickness="2.2" Fill="Transparent" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="+ Protect Folder" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Action 2: Unlock Folder -->
                                <Button Grid.Column="2" Style="{StaticResource OutlineBtn}" Command="{Binding SelectTabCommand}" CommandParameter="ProtectedFolders" Height="44">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoUnlock}" Stroke="{StaticResource BrandNavy}" StrokeThickness="1.8" Fill="Transparent" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Unlock Folder" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Action 3: Security Events -->
                                <Button Grid.Column="4" Style="{StaticResource OutlineBtn}" Command="{Binding SelectTabCommand}" CommandParameter="SecurityEvents" Height="44">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoActivity}" Stroke="{StaticResource BrandNavy}" StrokeThickness="1.8" Fill="Transparent" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Security Events" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Action 4: Run Security Check -->
                                <Button Grid.Column="6" Style="{StaticResource OutlineBtn}" Command="{Binding ScanRecoveryCommand}" Height="44">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoRotateCcw}" Stroke="{StaticResource BrandNavy}" StrokeThickness="1.8" Fill="Transparent" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Run Security Check" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 3. DASHBOARD LOWER SECTION: TWO-COLUMN LAYOUT -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Left: Protected Folders List (3 most recent) -->
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="24" />
                                <!-- Right: Security Activity Timeline -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: PROTECTED FOLDERS -->
                            <Border Grid.Column="0" Style="{StaticResource SecurityCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Section Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Protected Folders" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalFoldersCount, Mode=OneWay}" Foreground="{StaticResource BrandNavy}" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Recent Folders List -->
                                    <StackPanel Grid.Row="1">
                                        <!-- Empty State if no folders -->
                                        <StackPanel Margin="0,20,0,24" HorizontalAlignment="Center" Visibility="{Binding HasRecentFolders, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRecentFolders}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Path Data="{StaticResource GeoFolderLock}" Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <TextBlock Text="No protected folders yet." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Click '+ Protect Folder' to secure your files with Windows permissions." FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Folder Items -->
                                        <ItemsControl ItemsSource="{Binding RecentFolders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="0,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Lock Status Icon -->
                                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{Binding StatusBadgeBackground}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource GeoLock}" Stroke="{Binding StatusBadgeForeground}" StrokeThickness="1.8" Fill="Transparent" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0">
                                                                <TextBlock Text="{Binding FolderName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding FolderPath}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" ToolTip="{Binding FolderPath}" />
                                                            </StackPanel>

                                                            <!-- Status Badge -->
                                                            <Border Grid.Column="2" Background="{Binding StatusBadgeBackground}" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBadgeForeground}" FontSize="10.5" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Bottom Action -->
                                    <Button Grid.Row="2" Content="View All Protected Folders →" Style="{StaticResource OutlineBtn}" Command="{Binding SelectTabCommand}" CommandParameter="ProtectedFolders" Margin="0,16,0,0" HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>

                            <!-- RIGHT COLUMN: SECURITY ACTIVITY -->
                            <Border Grid.Column="2" Style="{StaticResource SecurityCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Section Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <TextBlock Text="Security Activity" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Activity Timeline Items -->
                                    <StackPanel Grid.Row="1">
                                        <!-- Empty State if no events -->
                                        <StackPanel Margin="0,20,0,24" HorizontalAlignment="Center" Visibility="{Binding HasRecentEvents, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRecentEvents}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Path Data="{StaticResource GeoShieldCheck}" Stroke="{StaticResource SuccessGreen}" StrokeThickness="1.8" Fill="Transparent" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <TextBlock Text="Everything looks good." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="No security threats or integrity alerts detected." FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Recent Real Events -->
                                        <ItemsControl ItemsSource="{Binding RecentEvents}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Activity Indicator Dot -->
                                                            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding SeverityBadgeForeground}" VerticalAlignment="Top" Margin="0,5,0,0" />

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0">
                                                                <TextBlock Text="{Binding Description}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding FolderDisplay}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                            </StackPanel>

                                                            <!-- Timestamp -->
                                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Bottom Action -->
                                    <Button Grid.Row="2" Content="View Full Security Log →" Style="{StaticResource OutlineBtn}" Command="{Binding SelectTabCommand}" CommandParameter="SecurityEvents" Margin="0,16,0,0" HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!-- PAGE 2: FOLDER LOCKER (SECURITY ONBOARDING WORKFLOW)  -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="ViewFolderLocker">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="FolderLocker">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions>
                                <!-- Left: Folder Protection Interactive Setup -->
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="28" />
                                <!-- Right: How Protection Works (01-04) -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT SIDE: ACTION & CURRENT FOLDER SELECTION -->
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource SecurityCard}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <!-- Header with Shield/Folder Icon -->
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#EEF4FF" CornerRadius="10" Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoFolderLock}" Stroke="{StaticResource BrandNavy}" StrokeThickness="2" Fill="Transparent" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="Protect a Folder" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="Choose a folder and SecApper will secure it using native Windows NTFS permissions." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Selected Folder State or Empty Call to Action -->
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,20">
                                            <Grid>
                                                <!-- If folder is selected -->
                                                <StackPanel Visibility="{Binding HasSelectedLocker, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding SelectedLockerFolderName, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                                            <TextBlock Text="{Binding SelectedLockerPath, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="#EEF4FF" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SelectedLockerStatusText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" />
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- If no folder selected yet -->
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSelectedLocker}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="No folder currently loaded in locker" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="Select any folder from your computer to configure security permissions." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Buttons Row -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Select Folder" Style="{StaticResource OutlineBtn}" Command="{Binding SelectFolderForLockerCommand}" Height="42" Padding="18,0" Margin="0,0,10,0" />

                                            <!-- Lock Button -->
                                            <Button Content="Protect Folder" Command="{Binding LockSelectedLockerCommand}" Height="42" Padding="20,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BrandRedBtn}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedLockerLocked}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Unlock Button -->
                                            <Button Content="Unlock Folder" Command="{Binding UnlockSelectedLockerCommand}" Height="42" Padding="20,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryNavyBtn}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedLockerLocked}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Security Guarantees Note -->
                                <Border Style="{StaticResource SecurityCard}" Background="#F8FAFC" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="SECURITY GUARANTEES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                                        <TextBlock Text="• Protection applies Windows NTFS Access Control Lists (ACLs) directly to the folder." FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,2" />
                                        <TextBlock Text="• Locking never deletes or encrypts your files; unlocking completely restores your access." FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,2" />
                                        <TextBlock Text="• Double-clicking a protected folder in Windows Explorer triggers the SecApper unlock prompt." FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,2" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- RIGHT SIDE: HOW PROTECTION WORKS (01 - 04) -->
                            <Border Grid.Column="2" Style="{StaticResource SecurityCard}">
                                <StackPanel>
                                    <TextBlock Text="HOW PROTECTION WORKS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" Margin="0,0,0,20" />

                                    <!-- Step 01 -->
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="01" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandRed}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Select folder" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="Choose any sensitive or personal folder on your local drive." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Step 02 -->
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="02" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandRed}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Set password" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="Assign a unique folder password or use your installation Master PIN." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Step 03 -->
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="03" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandRed}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Apply protection" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="SecApper takes ownership and configures explicit NTFS deny rules." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Step 04 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="04" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandRed}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Verify protection" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="Security descriptor verified and real-time monitoring activated." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!-- PAGE 3: PROTECTED FOLDERS (HORIZONTAL SECURITY ROWS) -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="ViewProtectedFolders">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="ProtectedFolders">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Action Toolbar -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Protected Folders" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                <Border Background="#EEF4FF" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource BrandNavy}" FontSize="12" FontWeight="Bold">
                                        <Run Text="{Binding TotalFoldersCount, Mode=OneWay}" /><Run Text=" protected" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ Protect Folder" Style="{StaticResource BrandRedBtn}" Command="{Binding AddFolderCommand}" Height="38" Padding="18,0" Margin="0,0,8,0" />
                                <Button Content="Lock All" Style="{StaticResource OutlineBtn}" Command="{Binding LockAllCommand}" Height="38" Padding="14,0" Margin="0,0,8,0" />
                                <Button Content="🚨 Panic Lock" Style="{StaticResource DangerOutlineBtn}" Command="{Binding PanicLockCommand}" Height="38" Padding="14,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Clean Horizontal Security Rows Container -->
                        <Border Style="{StaticResource SecurityCard}" Padding="0">
                            <Grid>
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="48" Visibility="{Binding HasFolders, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFolders}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource GeoFolderLock}" Stroke="{StaticResource TextMuted}" StrokeThickness="1.6" Fill="Transparent" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                    <TextBlock Text="No folders are currently protected" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Protect your personal files and sensitive documents with Windows security permissions." FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,18" />
                                    <Button Content="+ Protect Folder" Style="{StaticResource BrandRedBtn}" Command="{Binding AddFolderCommand}" HorizontalAlignment="Center" Height="40" Padding="20,0" />
                                </StackPanel>

                                <!-- Horizontal Rows List -->
                                <ItemsControl ItemsSource="{Binding Folders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="24,16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Icon -->
                                                        <ColumnDefinition Width="40" />
                                                        <!-- Folder Info -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- Status & Protection Info -->
                                                        <ColumnDefinition Width="Auto" />
                                                        <!-- Actions -->
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Lock Icon Visual -->
                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{Binding StatusBadgeBackground}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource GeoLock}" Stroke="{Binding StatusBadgeForeground}" StrokeThickness="1.8" Fill="Transparent" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Folder Name & Path -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,16,0">
                                                        <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding FolderPath}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding FolderPath}" />
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0">
                                                            <Run Text="Protected • Monitoring Active  |  " /><Run Text="{Binding LastActivityText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Status Badge -->
                                                    <Border Grid.Column="2" Background="{Binding StatusBadgeBackground}" CornerRadius="14" Padding="12,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBadgeForeground}" FontSize="11" FontWeight="Bold" />
                                                    </Border>

                                                    <!-- Action Controls -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Unlock Button -->
                                                        <Button Content="Unlock" Style="{StaticResource OutlineBtn}" Command="{Binding DataContext.UnlockFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" Height="34" Padding="14,0" Margin="0,0,8,0" FontSize="12.5" />

                                                        <!-- Lock Button -->
                                                        <Button Content="Lock" Style="{StaticResource BrandRedBtn}" Command="{Binding DataContext.LockFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" Height="34" Padding="16,0" Margin="0,0,8,0" FontSize="12.5" />

                                                        <!-- Explorer Link -->
                                                        <Button Style="{StaticResource OutlineBtn}" Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Open folder in Explorer" Width="34" Height="34" Padding="0" Margin="0,0,6,0">
                                                            <Path Data="{StaticResource GeoExternalLink}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" Width="14" Height="14" />
                                                        </Button>

                                                        <!-- Details -->
                                                        <Button Style="{StaticResource OutlineBtn}" Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Security Details" Width="34" Height="34" Padding="0" Margin="0,0,6,0">
                                                            <Path Data="{StaticResource GeoInfo}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" Width="14" Height="14" />
                                                        </Button>

                                                        <!-- Remove from App -->
                                                        <Button Style="{StaticResource DangerOutlineBtn}" Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Remove from SecApper" Width="34" Height="34" Padding="0">
                                                            <Path Data="{StaticResource GeoTrash}" Stroke="{StaticResource BrandRed}" StrokeThickness="1.8" Fill="Transparent" Width="14" Height="14" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!-- PAGE 4: RANSOMWARE PROTECTION                        -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="ViewRansomware">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="RansomwareProtection">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Large Status Hero Card -->
                        <Border Style="{StaticResource HeroSecurityCard}" Margin="0,0,0,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Status Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{StaticResource SuccessBg}" CornerRadius="10" Width="44" Height="44" Margin="0,0,16,0" BorderBrush="{StaticResource SuccessBorder}" BorderThickness="1">
                                            <Path Data="{StaticResource GeoShieldAlert}" Stroke="{StaticResource SuccessGreen}" StrokeThickness="2" Fill="Transparent" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="RANSOMWARE PROTECTION" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" />
                                                <Border Background="{StaticResource SuccessBg}" BorderBrush="{StaticResource SuccessBorder}" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="● ACTIVE" Foreground="#027A48" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="SecApper is actively monitoring protected folders for suspicious file activity." FontSize="13.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 4 Metrics Grid -->
                                <Grid Grid.Row="1" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Protected Folders -->
                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Protected Folders" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="{Binding TotalFoldersCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Monitoring State -->
                                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Monitoring" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="ACTIVE" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Suspicious Activity -->
                                    <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Suspicious Activity" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="{Binding SuspiciousEventsCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Threat Level -->
                                    <Border Grid.Column="6" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Threat Level" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="{Binding ThreatLevelText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{Binding ThreatLevelBadgeColor, Mode=OneWay}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Heuristic Safeguard Rules -->
                                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="✓ Real-time NTFS FileSystemWatcher heuristics active" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,2" />
                                            <TextBlock Text="✓ Mass file modification heuristic threshold: 25 files/window" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,2" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="✓ Rapid renaming and unknown extension alteration guard active" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,2" />
                                            <TextBlock Text="✓ Local cryptographic canary detection engine active" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,2" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Emergency Action Buttons -->
                        <Border Style="{StaticResource SecurityCard}">
                            <StackPanel>
                                <TextBlock Text="Heuristic Testing &amp; Emergency Actions" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Run Heuristic Detection Test" Style="{StaticResource OutlineBtn}" Command="{Binding SimulateThreatAlertCommand}" Height="40" Padding="16,0" Margin="0,0,10,0" />
                                    <Button Content="Lock All Folders Now" Style="{StaticResource PrimaryNavyBtn}" Command="{Binding LockAllCommand}" Height="40" Padding="18,0" Margin="0,0,10,0" />
                                    <Button Content="🚨 Activate Emergency Panic Lock" Style="{StaticResource BrandRedBtn}" Command="{Binding PanicLockCommand}" Height="40" Padding="18,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!-- PAGE 5: SECURITY EVENTS (SECURITY TIMELINE)          -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="ViewSecurityEvents">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="SecurityEvents">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Filter Chips & Search Bar -->
                        <Border Style="{StaticResource SecurityCard}" Padding="16" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Filter Chips -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Search Input -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Action Buttons -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="All" Style="{StaticResource OutlineBtn}" Command="{Binding SetEventFilterCommand}" CommandParameter="ALL" Height="32" Padding="12,0" Margin="0,0,6,0" FontSize="12" />
                                    <Button Content="Info" Style="{StaticResource OutlineBtn}" Command="{Binding SetEventFilterCommand}" CommandParameter="INFO" Height="32" Padding="12,0" Margin="0,0,6,0" FontSize="12" />
                                    <Button Content="Warning" Style="{StaticResource OutlineBtn}" Command="{Binding SetEventFilterCommand}" CommandParameter="WARNING" Height="32" Padding="12,0" Margin="0,0,6,0" FontSize="12" />
                                    <Button Content="Threat" Style="{StaticResource OutlineBtn}" Command="{Binding SetEventFilterCommand}" CommandParameter="THREAT" Height="32" Padding="12,0" Margin="0,0,6,0" FontSize="12" />
                                    <Button Content="Critical" Style="{StaticResource OutlineBtn}" Command="{Binding SetEventFilterCommand}" CommandParameter="CRITICAL" Height="32" Padding="12,0" FontSize="12" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,0" Margin="16,0" Height="36">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource GeoSearch}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Fill="Transparent" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding EventSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Export Logs" Style="{StaticResource OutlineBtn}" Command="{Binding ExportEventsCommand}" Height="34" Padding="14,0" Margin="0,0,8,0" FontSize="12" />
                                    <Button Content="Clear Events" Style="{StaticResource OutlineBtn}" Command="{Binding ClearEventsCommand}" Height="34" Padding="14,0" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Timeline List -->
                        <Border Style="{StaticResource SecurityCard}" Padding="0">
                            <Grid>
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="48" Visibility="{Binding FilteredEvents.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FilteredEvents.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource GeoShieldCheck}" Stroke="{StaticResource SuccessGreen}" StrokeThickness="1.6" Fill="Transparent" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <TextBlock Text="No security events recorded" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="All protected folders are intact. No unauthorized access attempts detected." FontSize="12.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Timeline Items -->
                                <ItemsControl ItemsSource="{Binding FilteredEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="24,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Time -->
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />

                                                    <!-- Event Info -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,16,0">
                                                        <TextBlock Text="{Binding Description}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding FolderDisplay}" FontSize="12" Foreground="{StaticResource BrandNavy}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- Process -->
                                                    <TextBlock Grid.Column="2" Text="{Binding ProcessName}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessPath}" />

                                                    <!-- Severity Badge -->
                                                    <Border Grid.Column="3" Background="{Binding SeverityBadgeBackground}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SeverityText}" Foreground="{Binding SeverityBadgeForeground}" FontSize="10.5" FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!-- PAGE 6: RECOVERY CENTER                              -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="ViewRecovery">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Recovery">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Recovery Center Hero -->
                        <Border Style="{StaticResource HeroSecurityCard}" Margin="0,0,0,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,24">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#EEF4FF" CornerRadius="10" Width="44" Height="44" Margin="0,0,16,0">
                                            <Path Data="{StaticResource GeoRotateCcw}" Stroke="{StaticResource BrandNavy}" StrokeThickness="2" Fill="Transparent" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="RECOVERY CENTER" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" />
                                                <Border Background="{StaticResource SuccessBg}" BorderBrush="{StaticResource SuccessBorder}" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RecoveryStatusText, Mode=OneWay}" Foreground="#027A48" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Check and restore SecApper folder protection states after power loss or interrupted operations." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Content="RUN RECOVERY CHECK" Style="{StaticResource PrimaryNavyBtn}" Command="{Binding ScanRecoveryCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="40" Padding="18,0" />
                                </Grid>

                                <!-- System Health Status Rows -->
                                <Grid Grid.Row="1" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Database" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="✓ Healthy" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Permission Backups" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="✓ Available" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Folder States" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="✓ Consistent" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="6" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Recovery Service" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="✓ Ready" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <TextBlock Text="SecApper preserves original NTFS access control lists before applying security rules, ensuring safe restoration." FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Issues List (if any) -->
                        <Border Style="{StaticResource SecurityCard}" Visibility="{Binding HasRecoveryIssues, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Detected Inconsistencies Requiring Action" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrandRed}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding RecoveryIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource DangerBg}" BorderBrush="{StaticResource DangerBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Folder.FolderName}" FontWeight="Bold" FontSize="14" Foreground="#991B1B" />
                                                        <TextBlock Text="{Binding Folder.FolderPath}" FontSize="12" Foreground="#B91C1C" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#7F1D1D" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Repair Protection" Style="{StaticResource BrandRedBtn}" Command="{Binding DataContext.RepairProtectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Height="34" Padding="14,0" Margin="0,0,8,0" />
                                                        <Button Content="Restore Access" Style="{StaticResource OutlineBtn}" Command="{Binding DataContext.RestoreAccessCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Height="34" Padding="14,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!-- PAGE 7: SOFTWARE UPDATES                             -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="ViewUpdates">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Updates">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Style="{StaticResource HeroSecurityCard}" Margin="0,0,0,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#EEF4FF" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0">
                                            <Path Data="{StaticResource GeoDownloadCloud}" Stroke="{StaticResource BrandNavy}" StrokeThickness="2" Fill="Transparent" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SECAPPER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0">
                                                <Run Text="v" /><Run Text="{Binding CurrentAppVersion, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding UpdateStatusMessage, Mode=OneWay}" FontSize="13.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="CHECK FOR UPDATES" Style="{StaticResource BrandRedBtn}" Command="{Binding CheckForUpdatesCommand}" Height="40" Padding="20,0" Margin="0,0,8,0" />
                                        <Button Content="Simulate Update" Style="{StaticResource OutlineBtn}" Command="{Binding SimulateUpdateCommand}" Height="40" Padding="16,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <TextBlock Text="SecApper is built offline-first. Even without internet connectivity, your protected folders and passwords remain 100% secure." FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Configuration Card -->
                        <Border Style="{StaticResource SecurityCard}">
                            <StackPanel>
                                <TextBlock Text="Update Configuration" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" />

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Automatic Updates" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Periodically check the official manifest for security patches." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoCheckUpdates}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Update Manifest URL" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                                    <TextBox Grid.Row="1" Text="{Binding UpdateManifestUrl, UpdateSourceTrigger=PropertyChanged}" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="10,8" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!-- PAGE 8: SETTINGS (CLEAN SETTINGS NAVIGATION)         -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="ViewSettings">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Settings">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Settings Sub-Navigation Header -->
                        <Border Style="{StaticResource SecurityCard}" Padding="12" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="General" Style="{StaticResource OutlineBtn}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="General" Height="34" Padding="16,0" Margin="0,0,6,0" />
                                <Button Content="Security" Style="{StaticResource OutlineBtn}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Security" Height="34" Padding="16,0" Margin="0,0,6,0" />
                                <Button Content="Ransomware" Style="{StaticResource OutlineBtn}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Ransomware" Height="34" Padding="16,0" Margin="0,0,6,0" />
                                <Button Content="Updates" Style="{StaticResource OutlineBtn}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Updates" Height="34" Padding="16,0" Margin="0,0,6,0" />
                                <Button Content="Privacy" Style="{StaticResource OutlineBtn}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Privacy" Height="34" Padding="16,0" Margin="0,0,6,0" />
                                <Button Content="About" Style="{StaticResource OutlineBtn}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="About" Height="34" Padding="16,0" />
                            </StackPanel>
                        </Border>

                        <!-- GENERAL SETTINGS -->
                        <Border Style="{StaticResource SecurityCard}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="GENERAL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" Margin="0,0,0,16" />

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Windows Explorer Integration" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Right-click context menu and double-click unlock prompt in Windows Explorer." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ExplorerIntegrationEnabled}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="System Tray Running" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Minimize to notification tray to keep active protection running continuously." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="True" IsEnabled="False" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECURITY & MASTER PIN -->
                        <Border Style="{StaticResource SecurityCard}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SECURITY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" Margin="0,0,0,16" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Master Security PIN" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Universal PIN set during setup to unlock any folder or authorize administrative changes." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Change Master PIN" Command="{Binding ChangeMasterPinCommand}" Style="{StaticResource OutlineBtn}" Height="36" Padding="16,0" VerticalAlignment="Center" />
                                </Grid>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
