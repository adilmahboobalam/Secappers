<Window x:Class="SecApper.FolderLocker.Views.ChangeMasterPinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Master PIN — SecApper"
        Height="470" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F9FC"
        Foreground="#172033"
        Icon="pack://application:,,,/SecApper.FolderLocker;component/Resources/app.ico">
    <Window.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Change Master PIN" FontSize="18" FontWeight="Bold" Foreground="#122D55" />
            <TextBlock Text="Update the global administrative PIN for this installation." FontSize="12" Foreground="#667085" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Fields -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Current Master PIN" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <PasswordBox x:Name="CurrentBox" PasswordChanged="CurrentBox_PasswordChanged" Margin="0,0,0,14" />

            <TextBlock Text="New Master PIN (min 4 characters)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <PasswordBox x:Name="NewBox" PasswordChanged="NewBox_PasswordChanged" Margin="0,0,0,14" />

            <TextBlock Text="Confirm New Master PIN" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <PasswordBox x:Name="ConfirmBox" PasswordChanged="ConfirmBox_PasswordChanged" Margin="0,0,0,10" />

            <TextBlock x:Name="ErrorText" Foreground="#C5202B" FontSize="12" Visibility="Collapsed" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Cancel" Click="CancelButton_Click" Background="Transparent" Foreground="#64748B" FontWeight="SemiBold" Padding="16,8" BorderThickness="1" BorderBrush="#E2E8F0" Margin="0,0,8,0" Cursor="Hand" Height="38">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="2" Content="Update PIN" Click="SaveButton_Click" Background="#C5202B" Foreground="#FFFFFF" FontWeight="Bold" Padding="20,8" BorderThickness="0" Cursor="Hand" Height="38" IsDefault="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
