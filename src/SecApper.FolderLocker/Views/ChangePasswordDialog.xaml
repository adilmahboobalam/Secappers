<Window x:Class="SecApper.FolderLocker.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password — SecApper"
        Height="470" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F9FC"
        Foreground="#172033"
        Icon="../Resources/app.ico">
    <Window.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Change Folder Password" FontSize="18" FontWeight="Bold" Foreground="#122D55" />
            <TextBlock Text="{Binding FolderName, StringFormat='Update cryptographic credentials for {0}'}" FontSize="12" Foreground="#667085" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Fields -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Current Password" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <PasswordBox x:Name="CurrentBox" PasswordChanged="CurrentBox_PasswordChanged" Margin="0,0,0,14" />

            <TextBlock Text="New Password (min 6 characters)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <PasswordBox x:Name="NewBox" PasswordChanged="NewBox_PasswordChanged" Margin="0,0,0,14" />

            <TextBlock Text="Confirm New Password" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <PasswordBox x:Name="ConfirmBox" PasswordChanged="ConfirmBox_PasswordChanged" Margin="0,0,0,10" />

            <TextBlock x:Name="ErrorText" Foreground="#C5202B" FontSize="12" Visibility="Collapsed" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="90" Height="36" Margin="0,0,10,0" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Medium">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Update Password" Click="Update_Click" Width="140" Height="36" Background="#122D55" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
