<Window x:Class="SecApper.FolderLocker.Views.FolderDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Details — SecApper"
        Height="470" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F9FC"
        Foreground="#172033"
        Icon="pack://application:,,,/Resources/app.ico">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Folder Security Details" FontSize="18" FontWeight="Bold" Foreground="#122D55" />
            <TextBlock Text="Technical filesystem metadata and local protection parameters" FontSize="12" Foreground="#667085" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Details Grid Card -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="20" BorderBrush="#E5E9F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Folder Name:" FontWeight="SemiBold" Foreground="#667085" Margin="0,0,0,10" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FolderName}" FontWeight="Bold" Foreground="#122D55" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Filesystem Path:" FontWeight="SemiBold" Foreground="#667085" Margin="0,0,0,10" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FolderPath}" Foreground="#122D55" TextWrapping="Wrap" Margin="0,0,0,10" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Foreground="#667085" Margin="0,0,0,10" />
                <Border Grid.Row="2" Grid.Column="1" Background="{Binding StatusBadgeBackground}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" Foreground="{Binding StatusBadgeForeground}" FontSize="11" />
                </Border>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Protection Mode:" FontWeight="SemiBold" Foreground="#667085" Margin="0,0,0,10" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProtectionModeText}" Foreground="#122D55" FontWeight="SemiBold" Margin="0,0,0,10" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Registered Date:" FontWeight="SemiBold" Foreground="#667085" Margin="0,0,0,10" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CreatedAtText}" Foreground="#334155" Margin="0,0,0,10" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Last Locked:" FontWeight="SemiBold" Foreground="#667085" Margin="0,0,0,10" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastLockedText}" Foreground="#334155" Margin="0,0,0,10" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Last Unlocked:" FontWeight="SemiBold" Foreground="#667085" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastUnlockedText}" Foreground="#334155" />
            </Grid>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="2" Content="Close" Click="Close_Click" Width="100" Height="36" HorizontalAlignment="Right" Margin="0,16,0,0" Background="#122D55" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
