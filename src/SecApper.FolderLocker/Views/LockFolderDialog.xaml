<Window x:Class="SecApper.FolderLocker.Views.LockFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lock Folder — SecApper"
        Height="510" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F9FC"
        Foreground="#172033"
        Icon="pack://application:,,,/SecApper.FolderLocker;component/Resources/app.ico">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <!-- Logo & Title -->
            <RowDefinition Height="Auto" />
            <!-- Folder Info Card -->
            <RowDefinition Height="Auto" />
            <!-- Input Fields -->
            <RowDefinition Height="*" />
            <!-- Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header with Official Logo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <Border Background="#FFFFFF" CornerRadius="8" Padding="10,6" Margin="0,0,0,10" BorderBrush="#E5E9F0" BorderThickness="1" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/SecApper.FolderLocker;component/Resources/logo.png" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Text="Lock Folder?" FontSize="18" FontWeight="Bold" Foreground="#122D55" HorizontalAlignment="Center" />
            <TextBlock Text="This folder will be protected using Windows security permissions." FontSize="12" Foreground="#667085" HorizontalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Folder Info Card -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" BorderBrush="#E5E9F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Folder to Protect:" FontSize="11" FontWeight="SemiBold" Foreground="#667085" />
                <TextBlock Text="{Binding FolderPath}" FontSize="13" FontWeight="Bold" Foreground="#122D55" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                <TextBlock Text="Status: Ready to Lock" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Input Fields -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Create Security Password (min 6 characters)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,12">
                <PasswordBox x:Name="PwdBox" PasswordChanged="PwdBox_PasswordChanged" BorderThickness="0" Background="Transparent" Padding="10,8" FontSize="14" />
            </Border>

            <TextBlock Text="Confirm Password" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,8,0">
                <PasswordBox x:Name="ConfirmPwdBox" PasswordChanged="ConfirmPwdBox_PasswordChanged" BorderThickness="0" Background="Transparent" Padding="10,8" FontSize="14" />
            </Border>

            <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                <TextBlock Text="💡 Note: Your installation Master PIN can also unlock this folder anytime." FontSize="11" Foreground="#475569" />
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="#C5202B" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="90" Height="36" Margin="0,0,10,0" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Medium">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Lock Folder" Click="Lock_Click" Width="120" Height="36" Background="#C5202B" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
