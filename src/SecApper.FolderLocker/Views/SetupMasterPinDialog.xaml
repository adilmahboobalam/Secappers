<Window x:Class="SecApper.FolderLocker.Views.SetupMasterPinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to SecApper — Setup Master PIN"
        Height="540" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F9FC"
        Foreground="#172033"
        Icon="pack://application:,,,/Resources/app.ico">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Logo Header -->
            <RowDefinition Height="Auto" />
            <!-- Info Notice -->
            <RowDefinition Height="Auto" />
            <!-- PIN Input Fields -->
            <RowDefinition Height="*" />
            <!-- Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header with Official Logo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <Border Background="#FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,12" BorderBrush="#E5E9F0" BorderThickness="1" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/logo.png" Height="52" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Text="Welcome to SecApper" FontSize="20" FontWeight="Bold" Foreground="#122D55" HorizontalAlignment="Center" />
            <TextBlock Text="Create your Master Security PIN for this installation." FontSize="13" Foreground="#667085" HorizontalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Informational Callout Card -->
        <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="8" Padding="14,10" Margin="0,0,0,18" BorderBrush="#BFDBFE" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Resources/shield.png" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="1" FontSize="12" Foreground="#1E3A8A" LineHeight="17" VerticalAlignment="Center">
                    <Run FontWeight="Bold" Text="Master Key Access: " />
                    <Run Text="Your Master PIN can unlock any folder on this machine, safeguarding your files if you ever forget a specific folder password." />
                </TextBlock>
            </Grid>
        </Border>

        <!-- PIN Input Fields -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Create Master PIN (min 4 characters)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,14">
                <PasswordBox x:Name="PinBox" PasswordChanged="PinBox_PasswordChanged" KeyDown="PinBox_KeyDown" BorderThickness="0" Background="Transparent" Padding="10,8" FontSize="14" />
            </Border>

            <TextBlock Text="Confirm Master PIN" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,6">
                <PasswordBox x:Name="ConfirmPinBox" PasswordChanged="ConfirmPinBox_PasswordChanged" KeyDown="ConfirmPinBox_KeyDown" BorderThickness="0" Background="Transparent" Padding="10,8" FontSize="14" />
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="#C5202B" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Set Master PIN &amp; Launch" Click="SaveButton_Click" Background="#C5202B" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Padding="20,10" BorderThickness="0" Cursor="Hand" Height="42" IsDefault="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
