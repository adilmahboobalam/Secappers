<Window x:Class="SecApper.FolderLocker.Views.UnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock Protected Folder — SecApper"
        Height="450" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        Foreground="#172033"
        Icon="../Resources/app.ico"
        Topmost="True"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <!-- Logo & Title -->
            <RowDefinition Height="Auto" />
            <!-- Folder Info Card -->
            <RowDefinition Height="Auto" />
            <!-- Password Input -->
            <RowDefinition Height="*" />
            <!-- Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top SecApper Header with Official Logo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <Border Background="#FFFFFF" CornerRadius="12" Padding="14,8" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/logo.png" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Text="Unlock Protected Folder" FontSize="18" FontWeight="Bold" Foreground="#122D55" HorizontalAlignment="Center" />
            <TextBlock Text="Enter your folder password or Master PIN to unlock." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Folder Info Card -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding FolderName}" FontSize="14" FontWeight="Bold" Foreground="#122D55" />
                <TextBlock Text="{Binding FolderPath}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Password Input -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Folder Password or Master PIN" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <PasswordBox x:Name="PwdBox" PasswordChanged="PwdBox_PasswordChanged" KeyDown="PwdBox_KeyDown" BorderThickness="0" Background="Transparent" Padding="10,8" FontSize="14" Foreground="#0F172A" VerticalContentAlignment="Center" />
                    <TextBox x:Name="TxtBox" TextChanged="TxtBox_TextChanged" KeyDown="TxtBox_KeyDown" BorderThickness="0" Background="Transparent" Padding="10,8" FontSize="14" Foreground="#0F172A" VerticalContentAlignment="Center" Visibility="Collapsed" />

                    <Button x:Name="TogglePasswordButton" Grid.Column="1" Click="TogglePassword_Click" Background="Transparent" BorderThickness="0" Padding="10,6" Cursor="Hand" ToolTip="Show/Hide Password" Focusable="False">
                        <TextBlock x:Name="ToggleIcon" Text="👁" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="90" Height="36" Margin="0,0,10,0" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Medium">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Unlock Folder" Click="Unlock_Click" Width="120" Height="36" Background="#122D55" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
