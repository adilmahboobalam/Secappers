<Window x:Class="SecApper.FolderLocker.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update — SecApper"
        Height="470" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F9FC"
        Foreground="#172033"
        Icon="../Resources/app.ico">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Software Update Available" FontSize="18" FontWeight="Bold" Foreground="#122D55" />
            <TextBlock Text="A verified update is ready to install for SecApper." FontSize="12" Foreground="#667085" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Version Comparison Card -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#E5E9F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CURRENT VERSION" FontSize="11" FontWeight="Bold" Foreground="#667085" />
                    <TextBlock x:Name="CurrentVerText" Text="1.0.0" FontSize="16" FontWeight="Bold" Foreground="#334155" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="➜" FontSize="18" Foreground="#122D55" VerticalAlignment="Center" Margin="16,0" />

                <StackPanel Grid.Column="2">
                    <TextBlock Text="NEW VERSION" FontSize="11" FontWeight="Bold" Foreground="#667085" />
                    <TextBlock x:Name="NewVerText" Text="1.1.0" FontSize="16" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Release Notes Box -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" Padding="14" Margin="0,0,0,16" BorderBrush="#E5E9F0" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Release Notes &amp; Improvements:" FontSize="12" FontWeight="Bold" Foreground="#122D55" Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReleaseNotesText" Text="Security engine improvements, crash-safe state recovery, and stability updates." 
                               TextWrapping="Wrap" FontSize="12" Foreground="#667085" LineHeight="18" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Progress Bar (Visible during download) -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid Margin="0,0,0,6">
                <TextBlock x:Name="ProgressStatusText" Text="Downloading update..." FontSize="12" Foreground="#334155" HorizontalAlignment="Left" />
                <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#122D55" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#E2E8F0" Foreground="#122D55" BorderThickness="0">
                <ProgressBar.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </ProgressBar.Resources>
            </ProgressBar>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LaterButton" Content="Later" Click="Later_Click" Width="90" Height="36" Margin="0,0,10,0" 
                    Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="Medium">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="UpdateNowButton" Content="Update Now" Click="UpdateNow_Click" Width="130" Height="36" 
                    Background="#C5202B" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
